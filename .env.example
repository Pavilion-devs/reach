# Copy to .env. The server loads this file locally; credentials never enter the browser.
REACH_PROVIDER=demo
REACH_AUTO_SETUP=true
PORT=4317
# For a dedicated Google test account, switch provider to google.
# Create an OAuth web client; authorized redirect URI:
# http://127.0.0.1:4317/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing refresh token is also supported instead of the browser consent flow.
GOOGLE_REFRESH_TOKEN=
# Pin one test email and one folder of PDF attachments for this prototype.
REACH_MESSAGE_ID=
REACH_DRIVE_FOLDER_ID=
REACH_CALENDAR_ID=primary
REACH_TIMEZONE=Africa/Lagos
# Explicit future ISO instants (30-minute meetings). Comma-separated; at least two.
REACH_SLOT_STARTS=
# AI configuration can instead live in the ignored, owner-only .anthropic.env.
# Practice mode does not call a model. Google/Arga mode requires AI configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Required only for keys that are not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Hosted-only: set a random 32+ character owner key in Vercel production env.
# Leave local configuration blank; do not commit a real value.
REACH_OWNER_KEY=
