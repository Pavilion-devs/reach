{
  "name": "reach-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "arga:provision": "python3 arga-setup.py provision",
    "arga:status": "python3 arga-setup.py status",
    "arga:verify": "node arga-verify.mjs",
    "arga:teardown": "python3 arga-setup.py teardown",
    "check": "node --check server.mjs && node --check src/engine.mjs && node --check src/providers.mjs && node --check public/app.js && node --check src/planner.mjs && node --check src/hosted-handler.mjs && node --check src/blob-task-store.mjs && node --check api/index.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  }
}
